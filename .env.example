# Future backend configuration only. The current static site reads no env files.
# Public API origin may be exposed to the browser after a real API is deployed.
PUBLIC_API_BASE_URL=

# Server-only sandbox settings. Never include these in dist/ or browser JS.
SANDBOX_BASE_URL=
SANDBOX_API_KEY=
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=128

# Future Cloudflare project bindings; configure D1 and Durable Objects in Wrangler.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
SESSION_SECRET=
